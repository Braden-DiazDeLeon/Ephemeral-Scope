# Frontend
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Regenerable, and large:
# scripts/build_training_dataset.py --all rebuilds it and data/manifest.json
# pins the packages, release ranges and hashes needed to verify the rebuild.
data/raw/
data/generated/

# Ignore everything under models/ except the verified classifier. The weak
# model was trained on suggested labels and is a diagnostic only; the
# verified one is small enough to track so a fresh clone can run the
# hybrid pipeline without retraining.
models/*
!models/release_note_classifier.joblib

# Committed on purpose, so the experiment can be reproduced:
#   results/*                  scores quoted in the report, from
#                              scripts/evaluate_classifiers.py
#   data/verified/*.jsonl      the balanced subsets carrying human labels
#   data/case_studies/*.jsonl  the held-out requests corpus
#   data/manifest.json         provenance for everything ignored above
